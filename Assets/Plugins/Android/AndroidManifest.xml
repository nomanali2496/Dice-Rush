<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.winjo.blingodice" xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:theme="@style/UnityThemeSelector" android:icon="@drawable/app_icon" android:label="@string/app_name" android:name="io.branch.unity.BranchUnityApp">
    <activity android:name="io.branch.unity.BranchUnityActivity" android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
      <meta-data android:name="unityplayer.ForwardNativeEventsToDalvik" android:value="true" />
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" android:host="blingodice.app.link" />
        <data android:scheme="https" android:host="blingodice-alternate.app.link" />
      </intent-filter>
      <intent-filter>
        <data android:host="open" android:scheme="blingodice" />
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
      </intent-filter>
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" android:host="blingodice.test-app.link" />
        <data android:scheme="https" android:host="blingodice-alternate.test-app.link" />
      </intent-filter>
    </activity>
    <!-- Optional. Set to true to disable auto deep link feature-->
    <meta-data android:name="io.branch.sdk.auto_link_disable" android:value="false" />
    <!--Set true to simulate fresh installs -->
    <meta-data android:name="io.branch.sdk.TestMode" android:value="true" />
    <!--Branch keys - both test and live-->
    <meta-data android:name="io.branch.sdk.BranchKey.test" android:value="key_test_hEAzfZd5zd4p9Nb53UEh6iifsAjNy3HM" />
    <meta-data android:name="io.branch.sdk.BranchKey" android:value="key_live_gqvue8d4El5a9Qe01SAi0hgjuzmQw4Is" />
  </application>
  <uses-permission android:name="android.permission.INTERNET" />
</manifest>